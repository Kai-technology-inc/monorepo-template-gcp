# Local development against the Firebase emulators (`pnpm dev`). Copy to `.env.local`.
# Deployed environments get these from apps/web/apphosting.<env>.yaml instead.
NEXT_PUBLIC_APP_ENVIRONMENT=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# Where the Auth emulator listens (default 127.0.0.1:9099; the browser tests run their own on 9399).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-template
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-template.firebaseapp.com
# Optional with the emulators; set them for a real project (Firebase console → Project settings → Web app).
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
