{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": false,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "declaration": false,
        "declarationMap": false,
        "plugins": [{ "name": "next" }],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.mts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    // Specs stay out of the program `next build` type-checks: App Hosting installs with `--prod` and vitest is not
    // there. `typecheck` checks them with tsconfig.spec.json, which is this file without the exclusion.
    "exclude": ["node_modules", "**/*.spec.ts", "**/*.spec.tsx", "vitest.config.mts"]
}
