# Local API server. `pnpm dev` copies this file to .env the first time; .env is git-ignored.

APP_ENVIRONMENT=local
PORT=3100

# The Firebase project. `demo-*` projects only work against the emulators, which is the point: nothing real is touched.
GCLOUD_PROJECT=demo-template

# The emulators (`pnpm emulators` at the root). Remove both lines to run against a real project with
# Application Default Credentials (`gcloud auth application-default login`).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# The web origins allowed to call the API from a browser (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# Verification emails only reach the Auth emulator UI locally, so it is off by default here.
AUTH_REQUIRE_VERIFIED_EMAIL=false

# Feature flags (docs/FLAGS.md). Who evaluates them: firestore (default, works with the emulators), launchdarkly,
# remote-config or memory.
FLAGS_PROVIDER=firestore
# The workspace whose owners and admins may operate flags through /workspaces/:workspaceId/flags. `*` (any
# workspace) is honored only with APP_ENVIRONMENT=local.
FLAGS_ADMIN_WORKSPACE_ID=*
# How long flag rules are cached per instance, and how long one evaluation may take before the default is served.
FLAGS_CACHE_SECONDS=15
FLAGS_TIMEOUT_MS=1000
# Only with FLAGS_PROVIDER=launchdarkly. Deployed, it is a Secret Manager secret, never a line in .env.
# LAUNCHDARKLY_SDK_KEY=
