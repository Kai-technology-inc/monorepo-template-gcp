{
    "name": "@app/api",
    "version": "0.1.0",
    "description": "The local API server (the same modules the Functions serve, under the same paths), the architecture tests of the whole repo, and the Firestore/Storage rules and indexes.",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": "22"
    },
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "dev": "node ./scripts/dev.mjs",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "test:arch": "vitest run --config vitest.arch.config.mts",
        "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-template-rules \"vitest run --config vitest.rules.config.mts\"",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@app/api-core": "workspace:*",
        "@app/api-host": "workspace:*",
        "@app/api-workspace": "workspace:*",
        "@app/contracts": "workspace:*",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "@nestjs/platform-express": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@app/eslint-config": "workspace:*",
        "@firebase/rules-unit-testing": "6.0.0",
        "@nestjs/testing": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "firebase": "catalog:",
        "prettier": "catalog:",
        "vitest": "catalog:"
    }
}
