{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "agentGuidance": false,
    "globalDependencies": ["tsconfig.base.json"],
    "globalPassThroughEnv": ["CI", "GITHUB_ACTIONS", "TZ"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
            "env": ["NEXT_PUBLIC_*", "APP_ENVIRONMENT", "NODE_ENV", "NEXT_DIST_DIR"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "test:arch": {
            "dependsOn": ["^build"]
        },
        "bundle:functions": {
            "dependsOn": ["build"],
            "cache": false,
            "outputs": [".functions/index.js", ".functions/index.js.map", ".functions/package.json"]
        }
    }
}
