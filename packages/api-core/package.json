{
    "name": "@app/api-core",
    "version": "0.1.0",
    "description": "Layer 1 of the API: configuration, Firebase Admin, authentication and session resolution, HTTP errors and validation, the persistence Store and the feature-flags port with its adapters. No product module lives here.",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": "22"
    },
    "exports": {
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/*.d.ts",
            "require": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/*"
            ]
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@app/contracts": "workspace:*",
        "@launchdarkly/node-server-sdk": "catalog:",
        "@nestjs/common": "catalog:",
        "@nestjs/core": "catalog:",
        "express": "catalog:",
        "firebase-admin": "catalog:",
        "reflect-metadata": "catalog:",
        "rxjs": "catalog:",
        "typescript": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@app/eslint-config": "workspace:*",
        "@nestjs/platform-express": "catalog:",
        "@nestjs/testing": "catalog:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "prettier": "catalog:",
        "vitest": "catalog:"
    }
}
