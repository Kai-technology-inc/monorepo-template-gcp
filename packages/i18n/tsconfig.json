{
    "extends": "../../tsconfig.base.json",
    // Published as source: Next transpiles it (`transpilePackages`), vitest runs it. Here it is only type-checked.
    "compilerOptions": {
        "types": ["node"],
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
