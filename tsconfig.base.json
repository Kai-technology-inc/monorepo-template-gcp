{
    "compilerOptions": {
        // Node globals (`process`, `Buffer`). Since TypeScript 6 an empty `types` means "none": every tsconfig names
        // the ambient types its code uses; the one that type-checks specs adds jest's.
        "types": ["node"],
        "target": "ES2022",
        "strict": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    }
}
